# PostgreSQL connection string used by the Drizzle access layer and migration tooling.
# Uses host port 5433 to match docker-compose.yml (mapped to the container's
# 5432), which avoids clashing with a native Postgres install on 5432. If you
# are not using docker-compose, adjust host/port/credentials to your database.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/league_manager

# Backend HTTP server port.
PORT=3000

# First-admin seed credentials (src/db/seed.ts). Change the password after first sign-in.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123
