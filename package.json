{
  "name": "basketball-league-management",
  "version": "0.1.0",
  "private": true,
  "description": "Basketball League Management System - monorepo (backend + web)",
  "type": "module",
  "workspaces": [
    "web"
  ],
  "scripts": {
    "build": "npm run build:backend && npm run build:web",
    "build:backend": "tsc -p tsconfig.backend.json",
    "build:web": "npm run build --workspace web",
    "typecheck": "npm run typecheck:backend && npm run typecheck:web",
    "typecheck:backend": "tsc -p tsconfig.backend.json --noEmit",
    "typecheck:web": "npm run typecheck --workspace web",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:push": "drizzle-kit push"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^3.23.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "dependencies": {
    "csv-parse": "^7.0.2",
    "drizzle-orm": "^0.38.0",
    "express": "^5.0.1",
    "postgres": "^3.4.5",
    "xlsx": "^0.18.5"
  }
}
